{
  "name": "hireshield",
  "version": "1.0.0",
  "description": "HireShield - Explainable Recruitment Fraud Early Warning & Education System",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && python -m pytest -v",
    "test:frontend": "cd frontend && npm test -- --run",
    "eval": "cd backend && python evaluate.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
